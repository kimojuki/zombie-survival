# Copie vers infra/docker/.env avant le premier lancement :
#   copy infra\docker\.env.example infra\docker\.env

# ── Données persistantes (bind mount hôte — survit crash / rebuild) ─────────
# Dev PC : ./data (défaut, sous infra/docker/data/)
# VM prod : /var/lib/zombie-survival
ZS_DATA_DIR=./data

# ── MariaDB ─────────────────────────────────────────────────────────────────
MARIADB_ROOT_PASSWORD=zs_root_change_me
DB_USER=zs_app
DB_PASS=zs_app_change_me

# ── Secrets JWT (identiques auth + game) ────────────────────────────────────
JWT_SECRET=change_me_docker_prod_sim
AUTH_JWT_SECRET=change_me_docker_prod_sim

# ── URL publique (Cloudflare HTTPS → cloudflared → nginx :443) ─────────────
ZS_TEAM_URL=https://survival.badom.ch
GAME_PUBLIC_URL=https://survival.badom.ch

# ── Rôle serveur ────────────────────────────────────────────────────────────
SERVER_ROLE=prod

# ── Admin / RCON (dev docker) ───────────────────────────────────────────────
RCON_PASSWORD=dev_admin_secret
OWNER_USERS=Bruno

# ── Logs ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Optionnel : exposer MariaDB sur l'hôte pour DBeaver (profil debug) ───────
# MARIADB_HOST_PORT=3307

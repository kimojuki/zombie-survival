# Zombie Survival — Infomaniak Node managé (sans Docker)
# Copier vers .env à la racine du repo sur le serveur :
#   cp .env.infomaniak.example .env
# Puis éditer les valeurs marquées CHANGER.

# ── App Node (Manager Infomaniak → Node.js) ───────────────────────────────────
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
TRUST_PROXY=true

# ── Auth (recommandé Infomaniak : un seul process pm2) ────────────────────────
# embedded = auth dans le game-server (MySQL game) — pas de auth-server séparé
# standalone = 2 process pm2 (zombie + zombie-auth) — voir docs/INFOMANIAK_NODE.md
AUTH_MODE=embedded
JWT_SECRET=CHANGER_openssl_rand_hex_32

# Si AUTH_MODE=standalone uniquement :
# AUTH_PORT=3001
# AUTH_HOST=127.0.0.1
# AUTH_JWT_SECRET=meme_secret_que_JWT_SECRET_ou_dédié
# AUTH_INTERNAL_URL=http://127.0.0.1:3001
# AUTH_INTERNAL_KEY=CHANGER_openssl_rand_hex_24
# AUTH_DB_CLIENT=mysql
# AUTH_DB_HOST=localhost
# AUTH_DB_PORT=3306
# AUTH_DB_USER=
# AUTH_DB_PASS=
# AUTH_DB_NAME=zombie_auth_db

# URL publique de ce serveur (preview Infomaniak)
ZS_PROD_URL=https://VOTRE-DOMAINE.preview.infomaniak.website
# URL équipe dev (lien menu)
ZS_TEAM_URL=https://survival.badom.ch

# ── MySQL / MariaDB managé Infomaniak ─────────────────────────────────────────
# Credentials : Manager Infomaniak → Bases de données → MariaDB
# DB_HOST = souvent localhost ou mysqlXXX.hosting.infomaniak.com
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=CHANGER
DB_PASS=CHANGER
DB_NAME=CHANGER_zombie_mobile

# ── Admin / RCON ──────────────────────────────────────────────────────────────
RCON_PASSWORD=CHANGER_mot_de_passe_fort
OWNER_USERS=votre_username,collegue_username
SERVER_ROLE=prod
LOG_LEVEL=info
LOG_DIR=logs/server

# ── PM2 (scripts/deploy-prod.sh) ──────────────────────────────────────────────
# ZOMBIE_PM2_NAME=zombie
# ZOMBIE_PM2_AUTH_NAME=zombie-auth
# ZOMBIE_DEPLOY_BRANCH=master

# ── Auto-deploy cron (optionnel) ──────────────────────────────────────────────
# DEPLOY_WEBHOOK_SECRET=
# DEPLOY_WEBHOOK_PORT=9090

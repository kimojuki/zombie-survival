PORT=3000
HOST=0.0.0.0
JWT_SECRET=change_me_in_real_deployments

# ── Serveur Auth interne (multi-shard — Phase A+) ─────────────────────────────
# Le FRONT PUBLIC reste sur PORT=3000 (survival.badom.ch via Cloudflare).
# auth-server écoute en local seulement — jamais exposé directement sur le tunnel.
#
# AUTH_PORT=3001
# AUTH_HOST=127.0.0.1
# AUTH_JWT_SECRET=change_me_same_on_auth_and_game_shards
# AUTH_DB_CLIENT=sqlite
# AUTH_SQLITE_PATH=database/auth-local.sqlite
# AUTH_INTERNAL_URL=http://127.0.0.1:3001   — cible proxy depuis game :3000
# AUTH_MODE=embedded                        — embedded (défaut) | standalone
# ZS_TEAM_URL=https://survival.badom.ch     — URL handoff game.html (front public)
# AUTH_INTERNAL_KEY=...                     — protège /api/auth/exchange server-to-server
# ── VM Ubuntu prod (Docker Compose) ───────────────────────────────────────────
# Stack complet : infra/docker/ — voir docs/VM_DEPLOY.md
# cp infra/docker/.env.example infra/docker/.env
# npm run docker:sim:up   (dev)  |  ./infra/docker/scripts/deploy-vm.sh (VM)

# Production (MariaDB dans conteneur Docker sur la VM)
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=zombie_mobile_db

# Dev local uniquement — copier ces lignes dans .env et commenter MySQL ci-dessus
# DB_CLIENT=sqlite
# SQLITE_PATH=database/local-dev.sqlite
# En SQLite sans RCON_PASSWORD, le serveur utilise "dev" par défaut
# RCON_AUTO_ADMIN=true  — en SQLite, tous les joueurs sont admin (dev local uniquement)

# ── Logs serveur (console + fichiers) ───────────────────────────────────────
# Niveaux : error | warn | info | debug | trace
# debug = snapshots joueurs + combat + stats (recommandé dev)
# info  = connect/disconnect, loot, morts (recommandé prod)
# trace = aussi les moves joueurs (très verbeux)
LOG_LEVEL=debug
LOG_DIR=logs/server
# LOG_FILE=0          — désactiver l'écriture fichier
# LOG_CONSOLE=plain   — console sans couleurs (pretty par défaut en TTY)
LOG_PLAYER_SNAPSHOT_MS=10000
LOG_SERVER_STATS_MS=60000
LOG_TICK_SUMMARY_MS=30000
LOG_SLOW_TICK_MS=80

# SERVER_ROLE=prod
# dev — réservé aux admins ; qa — checklist ; prod — public (défaut)
# Équipe Badom : dev + QA sur https://survival.badom.ch (alterner SERVER_ROLE dev/qa)
# Prod semi-prod : preview Infomaniak du pote (branche main) → ZS_PROD_URL

# URL serveur équipe (dev/QA) — défaut https://survival.badom.ch
# ZS_TEAM_URL=https://survival.badom.ch

# URL preview prod Infomaniak (à mettre sur survival.badom.ch pour le lien « Prod »)
# ZS_PROD_URL=https://3k51myccypp.preview.infomaniak.website

# Derrière Cloudflare / Infomaniak (obligatoire pour /api/servers et cookies proxy)
# TRUST_PROXY=true

# GUEST_COMMIT_MINUTES=8   — durée de jeu avant persistance invité (défaut 8)

# ── Base de données ───────────────────────────────────────────────────────────
# Doc complète : docs/RCON.md
#
# RCON_PASSWORD — active la console in-game (` ou F2) et l'API POST /api/rcon
# OWNER_USERS   — propriétaires (rôle owner, non rétrogradables via CMS)
# ADMIN_USERS   — alias rétrocompat (= propriétaires, fusionné avec OWNER_USERS)
#
# Exemple dev local :
# RCON_PASSWORD=dev_admin_secret
# OWNER_USERS=alice,bob

# RCON_PASSWORD=your_secret_admin_password
# OWNER_USERS=your_username,colleague_username
# ADMIN_USERS=your_username,colleague_username

# Derrière reverse proxy (Infomaniak prod ou cloudflared dev)
# TRUST_PROXY=true

# ── Benchmark perf local (localhost SQLite — notes-local/) ───────────────────
# PERF_USER=Bruno
# PERF_LOCAL_BENCH=1   — bench-token / perf-login sans mot de passe (dev seulement)
# PERF_PASS=...        — optionnel si PERF_LOCAL_BENCH désactivé
#
# npm run test:perf    — 1 client Chromium solo → notes-local/perf/latest.json
# npm run test:load    — bots Socket.io seuls (LOAD_COUNT=30 LOAD_RAMP=5)
# npm run test:bench   — benchmark réaliste : N navigateurs + bots socket concurrents
#   BENCH_CLIENTS=3 BENCH_SOCKET=25 BENCH_WALK_MS=15000 → notes-local/bench-real/latest.json
#   BENCH_HEADED=1     — afficher les fenêtres Chromium
#   BENCH_OVERLAP=1    — bots socket actifs pendant la phase navigateur (plus stressant)

# ── Auto-deploy prod (optionnel — voir docs/DEPLOY.md) ───────────────────────
# Webhook GitHub → scripts/webhook-deploy.js (alternative au cron)
# DEPLOY_WEBHOOK_SECRET=long_random_secret_here
# DEPLOY_WEBHOOK_PORT=9090
# ZOMBIE_PM2_NAME=zombie
# ZOMBIE_DEPLOY_BRANCH=master
